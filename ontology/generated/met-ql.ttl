time:hasBeginning a owl:ObjectProperty ;
    rdfs:domain time:Interval ;
    rdfs:range time:Instant .

time:hasEnd a owl:ObjectProperty ;
    rdfs:domain time:Interval ;
    rdfs:range time:Instant .

time:hasTime a owl:ObjectProperty .

time:inXSDDateTime a owl:DatatypeProperty ;
    rdfs:domain time:Instant ;
    rdfs:range xsd:dateTime .

sosa:hasFeatureOfInterest a owl:ObjectProperty ;
    rdfs:domain sosa:Observation ;
    rdfs:range sosa:FeatureOfInterest ;
    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000057> .

sosa:hasResult a owl:ObjectProperty ;
    rdfs:range <http://qudt.org/schema/qudt/QuantityValue> .

sosa:hosts a owl:ObjectProperty ;
    rdfs:domain sosa:Platform ;
    rdfs:range sosa:Sensor .

sosa:madeBySensor a owl:ObjectProperty ;
    rdfs:domain sosa:Observation ;
    rdfs:range sosa:Sensor ;
    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000057> .

sosa:observedProperty a owl:ObjectProperty ;
    rdfs:domain sosa:Observation ;
    rdfs:range sosa:ObservableProperty .

sosa:phenomenonTime a owl:ObjectProperty ;
    rdfs:domain sosa:Observation ;
    rdfs:range time:TemporalEntity ;
    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000199> .

sosa:resultTime a owl:DatatypeProperty ;
    rdfs:domain sosa:Observation ;
    rdfs:range xsd:dateTime .

<https://example.org/kgqa-met/ontology> rdfs:label "Ontologia meteorológica provisória (protótipo KGQA)"@pt .

met:AirTemperature a owl:NamedIndividual ;
    rdfs:label "air temperature"@en,
        "temperatura do ar"@pt .

met:AirTemperatureQuality a owl:Class ;
    rdfs:label "temperatura do ar (qualidade)"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> .

met:CloudCover a owl:NamedIndividual ;
    rdfs:label "nebulosidade"@pt .

met:CloudCoverQuality a owl:Class ;
    rdfs:label "nebulosidade (qualidade)"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> .

met:CloudGenusScheme rdfs:label "gêneros de nuvem"@pt .

met:CloudLayerObservation a owl:Class ;
    rdfs:label "observação de camada de nuvens"@pt ;
    rdfs:subClassOf sosa:Observation ;
    owl:disjointWith met:AccumulatedObservation .

met:DewPointTemperature a owl:NamedIndividual ;
    rdfs:label "temperatura do ponto de orvalho"@pt .

met:DewPointTemperatureQuality a owl:Class ;
    rdfs:label "temperatura do ponto de orvalho (qualidade)"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> .

met:InstantaneousObservation a owl:Class ;
    rdfs:label "observação instantânea"@pt ;
    rdfs:subClassOf sosa:Observation ;
    owl:disjointWith met:AccumulatedObservation .

met:Precipitation a owl:NamedIndividual ;
    rdfs:label "precipitation"@en,
        "precipitação"@pt .

met:PrecipitationAmountQuality a owl:Class ;
    rdfs:label "quantidade de precipitação (qualidade)"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> .

met:PrecipitationDuration a owl:NamedIndividual ;
    rdfs:label "duração da precipitação"@pt .

met:PrecipitationDurationQuality a owl:Class ;
    rdfs:label "duração da precipitação (qualidade)"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> .

met:PressureQNH a owl:NamedIndividual ;
    rdfs:label "pressão QNH"@pt .

met:PressureQNHQuality a owl:Class ;
    rdfs:label "pressão QNH (qualidade)"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> .

met:PrevailingVisibility a owl:NamedIndividual ;
    rdfs:label "visibilidade predominante"@pt .

met:PrevailingVisibilityQuality a owl:Class ;
    rdfs:label "visibilidade predominante (qualidade)"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> .

met:RelativeHumidity a owl:NamedIndividual ;
    rdfs:label "relative humidity"@en,
        "umidade relativa do ar"@pt .

met:RelativeHumidityQuality a owl:Class ;
    rdfs:label "umidade relativa (qualidade)"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> .

met:RunwayTemperature a owl:NamedIndividual ;
    rdfs:label "temperatura da pista"@pt .

met:RunwayTemperatureQuality a owl:Class ;
    rdfs:label "temperatura da pista (qualidade)"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> .

met:WetBulbTemperature a owl:NamedIndividual ;
    rdfs:label "temperatura de bulbo úmido"@pt .

met:WetBulbTemperatureQuality a owl:Class ;
    rdfs:label "temperatura de bulbo úmido (qualidade)"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> .

met:WindDirection a owl:NamedIndividual ;
    rdfs:label "direção do vento"@pt .

met:WindDirectionQuality a owl:Class ;
    rdfs:label "direção do vento (qualidade)"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> .

met:WindGust a owl:NamedIndividual ;
    rdfs:label "rajada de vento"@pt .

met:WindGustQuality a owl:Class ;
    rdfs:label "rajada de vento (qualidade)"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> .

met:WindSpeed a owl:NamedIndividual ;
    rdfs:label "velocidade do vento"@pt .

met:WindSpeedQuality a owl:Class ;
    rdfs:label "velocidade do vento (qualidade)"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> .

met:aggregationNote a owl:AnnotationProperty ;
    rdfs:label "nota sobre agregação"@pt .

met:alignmentStatus a owl:AnnotationProperty .

met:allowsAggregation a owl:ObjectProperty ;
    rdfs:label "admite agregação"@pt ;
    rdfs:domain sosa:ObservableProperty ;
    rdfs:range met:AggregationFunction .

met:alsoDomain a owl:AnnotationProperty .

met:answerCaveat a owl:AnnotationProperty .

met:bfoCategory a owl:AnnotationProperty .

met:canonicalUnit a owl:AnnotationProperty ;
    rdfs:label "unidade canônica"@pt .

met:cloudBaseHeight a owl:DatatypeProperty ;
    rdfs:label "altura da base da nuvem (m)"@pt ;
    rdfs:domain met:CloudLayerResult ;
    rdfs:range xsd:integer .

met:cloudGenus a owl:ObjectProperty ;
    rdfs:label "gênero da nuvem"@pt ;
    rdfs:domain met:CloudLayerResult ;
    rdfs:range skos:Concept .

met:cloudMovement a owl:DatatypeProperty ;
    rdfs:label "direção de deslocamento da nuvem"@pt ;
    rdfs:domain met:CloudLayerResult ;
    rdfs:range xsd:string .

